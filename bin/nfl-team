#!/usr/bin/env python3
"""Read/write the team the NFL widget follows.

The panel's team picker writes here so a chosen team survives restarts without
the user editing shell.json. The stored value wins over the widget's `team`
setting; clearing it hands control back to that setting.

Usage: nfl-team [--get] [--set SF] [--clear] [--path]
"""

import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import nflcommon  # noqa: E402  (hardened state-directory access)

VALID = re.compile(r"^[A-Za-z]{2,4}$")
FILENAME = "nfl-team.json"


def state_path():
    return os.path.join(nflcommon.state_path(), FILENAME)


def read_team():
    """The stored team, or "" for anything we would not act on.

    Never raises: a missing file, a symlink someone left in the state
    directory, or a hand-edited mess all mean the same thing here -- fall back
    to the widget setting rather than take the panel down.
    """
    try:
        dir_fd = nflcommon.open_dir(nflcommon.state_path())
    except OSError:
        return ""
    try:
        raw = nflcommon.read_bounded(dir_fd, FILENAME)
        if raw is None:
            return ""
        data = json.loads(raw.decode("utf-8", "replace"))
        team = str((data or {}).get("team") or "").strip().upper()
        return team if VALID.match(team) else ""
    except (OSError, ValueError):
        return ""
    finally:
        os.close(dir_fd)


def write_team(team):
    dir_fd = nflcommon.open_dir(nflcommon.state_path(), create=True)
    try:
        nflcommon.write_atomic(
            dir_fd, FILENAME, json.dumps({"team": team.upper()}))
    finally:
        os.close(dir_fd)


def clear_team():
    try:
        dir_fd = nflcommon.open_dir(nflcommon.state_path())
    except OSError:
        return
    try:
        os.unlink(FILENAME, dir_fd=dir_fd)
    except (FileNotFoundError, OSError):
        pass
    finally:
        os.close(dir_fd)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--get", action="store_true")
    ap.add_argument("--set", default="")
    ap.add_argument("--clear", action="store_true")
    ap.add_argument("--path", action="store_true")
    args = ap.parse_args()

    if args.path:
        print(state_path())
        return 0

    if args.clear:
        clear_team()
        return 0

    if args.set:
        team = args.set.strip()
        if not VALID.match(team):
            sys.stderr.write("nfl-team: not a team abbreviation: %s\n" % args.set)
            return 1
        try:
            write_team(team)
        except OSError as exc:
            # The panel's team picker calls this; a traceback on stderr would
            # be all it ever saw of the reason.
            sys.stderr.write("nfl-team: %s\n" % exc)
            return 1
        return 0

    print(read_team())
    return 0


if __name__ == "__main__":
    sys.exit(main())
