#!/usr/bin/env python3
"""Fetch an NFL team's full-season schedule + standings from ESPN's public API.

Emits one compact JSON document on stdout so the QML panel never has to parse
the ~250KB-per-seasontype responses itself. Preseason (1), regular season (2)
and postseason (3) are merged into a single chronological game list.

Usage: nfl-data [--team sf] [--max-age 900] [--cache PATH] [--no-cache]
"""

import argparse
import json
import os
import signal
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import nflcommon  # noqa: E402  (hardened state-directory access, bounded reads)

SITE = "https://site.api.espn.com/apis/site/v2/sports/football/nfl"
CORE = "https://site.api.espn.com/apis/v2/sports/football/nfl"

# 4 (offseason/Pro Bowl) carries no team games and is skipped.
SEASON_TYPES = [
    (1, "Preseason", "PRE"),
    (2, "Regular Season", "REG"),
    (3, "Postseason", "POST"),
]

TIMEOUT = 12
# TIMEOUT only bounds a single socket operation, so a server that keeps sending
# a byte every few seconds would hold a request open for hours. This bounds the
# whole request, headers and body together.
REQUEST_DEADLINE = 20

# Matches bin/nfl-team: the abbreviation reaches a URL and a file name.
TEAM_RE = __import__("re").compile(r"^[a-z]{2,4}$")

# The 32 teams are stable across a season, so the picker falls back to this
# list whenever the roster endpoint is unreachable. Refreshed from ESPN into
# its own long-lived cache; see fetch_teams().
FALLBACK_TEAMS = [
    ('ARI', 'Arizona Cardinals', 'Cardinals'),
    ('ATL', 'Atlanta Falcons', 'Falcons'),
    ('BAL', 'Baltimore Ravens', 'Ravens'),
    ('BUF', 'Buffalo Bills', 'Bills'),
    ('CAR', 'Carolina Panthers', 'Panthers'),
    ('CHI', 'Chicago Bears', 'Bears'),
    ('CIN', 'Cincinnati Bengals', 'Bengals'),
    ('CLE', 'Cleveland Browns', 'Browns'),
    ('DAL', 'Dallas Cowboys', 'Cowboys'),
    ('DEN', 'Denver Broncos', 'Broncos'),
    ('DET', 'Detroit Lions', 'Lions'),
    ('GB', 'Green Bay Packers', 'Packers'),
    ('HOU', 'Houston Texans', 'Texans'),
    ('IND', 'Indianapolis Colts', 'Colts'),
    ('JAX', 'Jacksonville Jaguars', 'Jaguars'),
    ('KC', 'Kansas City Chiefs', 'Chiefs'),
    ('LAC', 'Los Angeles Chargers', 'Chargers'),
    ('LAR', 'Los Angeles Rams', 'Rams'),
    ('LV', 'Las Vegas Raiders', 'Raiders'),
    ('MIA', 'Miami Dolphins', 'Dolphins'),
    ('MIN', 'Minnesota Vikings', 'Vikings'),
    ('NE', 'New England Patriots', 'Patriots'),
    ('NO', 'New Orleans Saints', 'Saints'),
    ('NYG', 'New York Giants', 'Giants'),
    ('NYJ', 'New York Jets', 'Jets'),
    ('PHI', 'Philadelphia Eagles', 'Eagles'),
    ('PIT', 'Pittsburgh Steelers', 'Steelers'),
    ('SEA', 'Seattle Seahawks', 'Seahawks'),
    ('SF', 'San Francisco 49ers', '49ers'),
    ('TB', 'Tampa Bay Buccaneers', 'Buccaneers'),
    ('TEN', 'Tennessee Titans', 'Titans'),
    ('WSH', 'Washington Commanders', 'Commanders'),
]

TEAMS_TTL = 7 * 24 * 3600

# What a failed or garbled ESPN request raises. HTTPError is a URLError, a
# timeout an OSError, a body that is not JSON a ValueError.
FETCH_ERRORS = (urllib.error.URLError, ValueError, OSError)


def _deadline_passed(_signum, _frame):
    # A TimeoutError is an OSError, so callers treat it like any other failed
    # fetch and fall back to the cache.
    raise TimeoutError("ESPN request took longer than %d s" % REQUEST_DEADLINE)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    # The ESPN endpoints answer directly. Following a redirect would let urllib
    # drain the redirect body with an unbounded read() before our byte cap ever
    # sees it, so refuse instead: the 3xx surfaces as an HTTPError (a URLError)
    # with its body unread, and the caller falls back to the cache.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_opener = urllib.request.build_opener(_NoRedirect)


def get(url):
    # ESPN 403s unknown and browser-like agents alike; a curl UA is accepted.
    #
    # Read through a byte cap rather than json.load()ing the stream: the parser
    # would happily follow a response that never ends, and whatever it built
    # goes on to a QML collector that buffers the lot.
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8.7.1"})
    previous = signal.signal(signal.SIGALRM, _deadline_passed)
    signal.setitimer(signal.ITIMER_REAL, REQUEST_DEADLINE)
    try:
        with _opener.open(req, timeout=TIMEOUT) as resp:
            return nflcommon.load_json_bounded(resp)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def num(stats, name):
    """Pull a stat out of an ESPN standings entry by its `name` key."""
    for s in stats or []:
        if s.get("name") == name:
            return s
    return None


def stat_display(stats, name, fallback=""):
    s = num(stats, name)
    if not s:
        return fallback
    v = s.get("displayValue")
    return fallback if v in (None, "") else str(v)


def stat_value(stats, name, fallback=0.0):
    s = num(stats, name)
    if not s or s.get("value") is None:
        return fallback
    try:
        return float(s["value"])
    except (TypeError, ValueError):
        return fallback


def score_of(competitor):
    """Scores are {value, displayValue} when played, null when scheduled."""
    raw = competitor.get("score")
    if raw is None:
        return None
    if isinstance(raw, dict):
        v = raw.get("value")
        if v is None:
            d = raw.get("displayValue")
            return None if d in (None, "") else int(float(d))
        return int(float(v))
    try:
        return int(float(raw))
    except (TypeError, ValueError):
        return None


# The longest NFL phase is the regular season, 18 weeks since 2021. Anything
# past this is not a real week number, and the panel loops up to the largest
# week it sees, so it must never get a huge one.
MAX_WEEK = 25


def week_number(value):
    """ESPN's week number if it is a plausible one, otherwise 0 (unknown)."""
    if isinstance(value, bool) or not isinstance(value, int):
        return 0
    return value if 1 <= value <= MAX_WEEK else 0


def parse_event(event, team_abbr, stype_id, stype_name, stype_abbr):
    comps = event.get("competitions") or []
    if not comps:
        return None
    comp = comps[0]
    competitors = comp.get("competitors") or []

    me = opp = None
    for c in competitors:
        abbr = ((c.get("team") or {}).get("abbreviation") or "").upper()
        if abbr == team_abbr.upper():
            me = c
        else:
            opp = c
    if me is None or opp is None:
        return None

    status = comp.get("status") or {}
    stype = status.get("type") or {}
    state = stype.get("state") or "pre"
    completed = bool(stype.get("completed"))

    my_score = score_of(me)
    opp_score = score_of(opp)

    result = ""
    if completed and my_score is not None and opp_score is not None:
        if my_score > opp_score:
            result = "W"
        elif my_score < opp_score:
            result = "L"
        else:
            result = "T"

    opp_team = opp.get("team") or {}
    venue = comp.get("venue") or {}
    addr = venue.get("address") or {}
    week = event.get("week") or {}

    return {
        "id": str(event.get("id") or ""),
        "date": event.get("date") or "",
        "seasonType": stype_id,
        "seasonTypeName": stype_name,
        "seasonTypeAbbr": stype_abbr,
        "week": week_number(week.get("number")),
        "weekText": week.get("text") or "",
        "shortName": event.get("shortName") or "",
        "homeAway": me.get("homeAway") or "",
        "neutralSite": bool(comp.get("neutralSite")),
        "opponent": (opp_team.get("abbreviation") or "").upper(),
        "opponentName": opp_team.get("displayName") or "",
        "opponentShort": opp_team.get("shortDisplayName") or "",
        "state": state,
        "completed": completed,
        "detail": stype.get("detail") or "",
        "shortDetail": stype.get("shortDetail") or "",
        "description": stype.get("description") or "",
        "period": status.get("period") or 0,
        "displayClock": status.get("displayClock") or "",
        "teamScore": my_score,
        "oppScore": opp_score,
        "result": result,
        "venue": venue.get("fullName") or "",
        "venueCity": addr.get("city") or "",
    }


def fetch_schedule(team, season, stype_id, stype_name, stype_abbr):
    # A failed request raises: an empty list would read as "no games of this
    # type" and end up in the cache. See build().
    url = "%s/teams/%s/schedule?season=%d&seasontype=%d" % (SITE, team, season, stype_id)
    data = get(url)
    out = []
    for event in data.get("events") or []:
        g = parse_event(event, team, stype_id, stype_name, stype_abbr)
        if g:
            out.append(g)
    return out


def parse_entry(entry, rank):
    team = entry.get("team") or {}
    stats = entry.get("stats") or []
    wins = int(stat_value(stats, "wins"))
    losses = int(stat_value(stats, "losses"))
    ties = int(stat_value(stats, "ties"))
    record = stat_display(stats, "overall")
    if not record:
        record = "%d-%d" % (wins, losses) + ("-%d" % ties if ties else "")
    return {
        "rank": rank,
        "abbr": (team.get("abbreviation") or "").upper(),
        "name": team.get("displayName") or "",
        "short": team.get("shortDisplayName") or "",
        "wins": wins,
        "losses": losses,
        "ties": ties,
        "record": record,
        "pct": stat_display(stats, "winPercent", "-"),
        "pointsFor": int(stat_value(stats, "pointsFor")),
        "pointsAgainst": int(stat_value(stats, "pointsAgainst")),
        "diff": stat_display(stats, "pointDifferential", "0"),
        "streak": stat_display(stats, "streak", "-"),
        "seed": int(stat_value(stats, "playoffSeed")),
        "gamesBehind": stat_display(stats, "gamesBehind", "-"),
        "home": stat_display(stats, "Home", "-"),
        "road": stat_display(stats, "Road", "-"),
        "div": stat_display(stats, "vs. Div.", "-"),
        "conf": stat_display(stats, "vs. Conf.", "-"),
    }


def fetch_standings(team_abbr, season):
    # Raises on a failed request, like fetch_schedule().
    url = "%s/standings?season=%d&level=3" % (CORE, season)
    data = get(url)

    my_div = my_conf = None
    div_name = conf_name = ""
    conf_entries = []

    for conference in data.get("children") or []:
        conf_rows = []
        found_here = False
        for division in conference.get("children") or []:
            entries = ((division.get("standings") or {}).get("entries")) or []
            rows = [parse_entry(e, i + 1) for i, e in enumerate(entries)]
            conf_rows.extend(rows)
            if any(r["abbr"] == team_abbr.upper() for r in rows):
                found_here = True
                my_div = rows
                div_name = division.get("name") or ""
        if found_here:
            my_conf = conf_rows
            conf_name = conference.get("name") or ""
            conf_entries = conf_rows

    def conf_sort(row):
        # Seed is 0 before it is published; fall back to win pct then diff.
        seed = row["seed"] if row["seed"] > 0 else 99
        try:
            pct = float(row["pct"])
        except ValueError:
            pct = 0.0
        try:
            diff = float(str(row["diff"]).replace("+", ""))
        except ValueError:
            diff = 0.0
        return (seed, -pct, -diff)

    conference = sorted(conf_entries, key=conf_sort) if conf_entries else []
    for i, row in enumerate(conference):
        row["confRank"] = i + 1

    return {
        "division": my_div or [],
        "divisionName": div_name,
        "conference": conference,
        "conferenceName": conf_name,
    }


def fetch_teams():
    """All NFL teams for the picker: abbreviation, full name, short name."""
    try:
        data = get("%s/teams" % SITE)
        entries = data["sports"][0]["leagues"][0]["teams"]
        out = []
        for entry in entries:
            t = entry.get("team") or {}
            abbr = (t.get("abbreviation") or "").upper()
            if not abbr:
                continue
            out.append({
                "abbr": abbr,
                "name": t.get("displayName") or abbr,
                "short": t.get("shortDisplayName") or abbr,
            })
        if len(out) >= 30:
            return sorted(out, key=lambda x: x["abbr"])
    except (urllib.error.URLError, ValueError, OSError, KeyError, IndexError):
        pass
    return [{"abbr": a, "name": n, "short": s} for a, n, s in FALLBACK_TEAMS]


def teams_payload(dir_fd, name, max_age):
    if max_age > 0:
        try:
            age = nflcommon.age_seconds(dir_fd, name)
            if age is not None and age < max_age:
                raw = nflcommon.read_bounded(dir_fd, name)
                if raw is not None:
                    return raw.decode("utf-8", "replace")
        except OSError:
            pass
    payload = json.dumps({"teams": fetch_teams()}, separators=(",", ":"))
    write_cache(dir_fd, name, payload)
    return payload


def write_cache(dir_fd, name, payload):
    # Best effort: a cache we could not refresh is not worth failing a fetch
    # over -- the caller already holds the payload it was asked for.
    try:
        nflcommon.write_atomic(dir_fd, name, payload)
    except OSError:
        pass


EMPTY_STANDINGS = {"division": [], "divisionName": "", "conference": [], "conferenceName": ""}


def build(team, previous=None):
    """Fetch everything for one team. Returns (payload, complete).

    A failure on the first request raises, and main() falls back to the stale
    cache. A failure on one of the later ones -- a season type's schedule, the
    standings -- is patched from `previous`, the last cached payload, when that
    is the same team and season, and `complete` comes back False so the caller
    does not cache the patched result as fresh. Without that a single dropped
    request replaced a full season with three preseason games and an empty
    table, and the cache held it until the next good fetch.
    """
    meta = get("%s/teams/%s/schedule" % (SITE, team))
    season_info = meta.get("season") or {}
    season = int(season_info.get("year") or 0)
    if not season:
        raise RuntimeError("no season year in ESPN response")

    team_info = meta.get("team") or {}
    team_abbr = (team_info.get("abbreviation") or team).upper()

    if not (isinstance(previous, dict) and previous.get("season") == season
            and str((previous.get("team") or {}).get("abbr") or "").upper() == team_abbr):
        previous = None

    complete = True
    games = []
    for stype_id, stype_name, stype_abbr in SEASON_TYPES:
        try:
            games.extend(fetch_schedule(team, season, stype_id, stype_name, stype_abbr))
        except FETCH_ERRORS:
            complete = False
            if previous:
                games.extend(g for g in previous.get("games") or []
                             if isinstance(g, dict) and g.get("seasonType") == stype_id)

    # ESPN can repeat an event across seasontype queries; keep one per id.
    seen = set()
    unique = []
    for g in games:
        if g["id"] and g["id"] in seen:
            continue
        seen.add(g["id"])
        unique.append(g)
    unique.sort(key=lambda g: (g["date"], g["seasonType"]))

    played = [g for g in unique if g["completed"]]
    wins = sum(1 for g in played if g["result"] == "W")
    losses = sum(1 for g in played if g["result"] == "L")
    ties = sum(1 for g in played if g["result"] == "T")

    try:
        standings = fetch_standings(team_abbr, season)
    except FETCH_ERRORS:
        complete = False
        standings = (previous or {}).get("standings") or dict(EMPTY_STANDINGS)

    return {
        "fetchedAt": int(time.time()),
        "season": season,
        "seasonType": int(season_info.get("type") or 0),
        "seasonTypeName": season_info.get("name") or "",
        "team": {
            "abbr": team_abbr,
            "name": team_info.get("displayName") or "",
            "short": team_info.get("shortDisplayName") or team_info.get("nickname") or "",
            "color": team_info.get("color") or "",
        },
        "record": {"wins": wins, "losses": losses, "ties": ties},
        "games": unique,
        "standings": standings,
    }, complete


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--team", default="sf")
    ap.add_argument("--teams", action="store_true",
                    help="print the 32-team roster for the picker and exit")
    ap.add_argument("--max-age", type=int, default=900)
    ap.add_argument("--cache", default="")
    ap.add_argument("--no-cache", action="store_true")
    args = ap.parse_args()

    # The abbreviation goes into a URL path and into a cache file name, so it
    # is checked before either. bin/nfl-team already holds this line; the
    # `team` widget setting reaches us without passing through it.
    team = args.team.strip().lower() or "sf"
    if not TEAM_RE.match(team):
        sys.stderr.write("nfl-data: not a team abbreviation: %s\n" % args.team)
        return 2

    # --cache names a file the caller chose, so its directory is opened and
    # checked like any other; everything else lives in the state directory.
    if args.cache:
        cache_dir = os.path.dirname(os.path.abspath(args.cache)) or "."
        cache_name = os.path.basename(args.cache)
        create_dir = False
    else:
        cache_dir = nflcommon.state_path()
        cache_name = "nfl-%s.json" % team
        create_dir = True

    try:
        dir_fd = nflcommon.open_dir(cache_dir, create=create_dir)
    except OSError as exc:
        sys.stderr.write("nfl-data: %s\n" % exc)
        return 1

    try:
        if args.teams:
            # The roster barely changes, so it gets its own long-lived cache
            # rather than riding along with every schedule refresh.
            max_age = 0 if args.no_cache else TEAMS_TTL
            nflcommon.emit(teams_payload(dir_fd, "nfl-teams.json", max_age))
            return 0

        if not args.no_cache and args.max_age > 0:
            try:
                age = nflcommon.age_seconds(dir_fd, cache_name)
                if age is not None and age < args.max_age:
                    raw = nflcommon.read_bounded(dir_fd, cache_name)
                    if raw is not None:
                        nflcommon.emit(raw.decode("utf-8", "replace"))
                        return 0
            except OSError:
                pass

        previous = None
        try:
            raw = nflcommon.read_bounded(dir_fd, cache_name)
            if raw is not None:
                previous = json.loads(raw.decode("utf-8", "replace"))
        except (OSError, ValueError):
            pass

        try:
            data, complete = build(team, previous)
            payload = json.dumps(data, separators=(",", ":"))
        except Exception as exc:  # noqa: BLE001 - stale cache beats an empty panel
            try:
                raw = nflcommon.read_bounded(dir_fd, cache_name)
                if raw is not None:
                    nflcommon.emit(raw.decode("utf-8", "replace"))
                    return 0
            except OSError:
                pass
            sys.stderr.write("nfl-data: %s\n" % exc)
            return 1

        # A patched result is shown but not cached: the cache keeps its age,
        # so the next run tries ESPN again instead of trusting it.
        if not args.no_cache and complete:
            write_cache(dir_fd, cache_name, payload)

        nflcommon.emit(payload)
        return 0
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    sys.exit(main())
